}

// ============================= COMPRAS =============================

function Compras({ products, purchases, productMap, onAdd, onDelete }) {
  const [modal, setModal] = useState(false);
  const sorted = [...purchases].sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));

  return (
    <div>
      <PageHeader
        eyebrow="Compras"
        title="Registro de compras"
        subtitle="Cada compra suma stock y actualiza el costo del producto."
        action={<button style={styles.primaryBtn} onClick={() => setModal(true)} disabled={products.length === 0}><Plus size={16} /> Nueva compra</button>}
      />
      {products.length === 0 && <EmptyNote text="Primero crea productos en Inventario para poder comprarlos." />}
      {sorted.length === 0 && products.length > 0 ? (
        <EmptyNote text="No has registrado compras todavía." />
      ) : (
        <MovementTable
          rows={sorted}
          columns={["Fecha", "Producto", "Proveedor", "Cantidad", "Costo unit.", "Total", ""]}
          renderRow={(p) => (
            <>
              <td>{dateFmt(p.date)}</td>
              <td>{productMap[p.productId]?.name || "Producto eliminado"}</td>
              <td>{p.vendor || "—"}</td>
              <td>{p.qty}</td>
              <td>{money(p.unitCost)}</td>
              <td style={{ color: "#E8A63D", fontWeight: 600 }}>{money(p.qty * p.unitCost)}</td>
              <td><button style={styles.rowDeleteBtn} onClick={() => onDelete(p.id)}><Trash2 size={13} /></button></td>
            </>
          )}
        />
      )}
      {modal && (
        <PurchaseModal
          products={products}
          onClose={() => setModal(false)}
          onSave={(payload) => { onAdd(payload); setModal(false); }}
        />
      )}
    </div>
  );
}

function PurchaseModal({ products, onClose, onSave }) {
  const [productId, setProductId] = useState(products[0]?.id || "");
  const [qty, setQty] = useState(1);
  const [unitCost, setUnitCost] = useState(products[0]?.costPrice || 0);
  const [vendor, setVendor] = useState("");
  const [date, setDate] = useState(todayStr());
  const [err, setErr] = useState("");

  useEffect(() => {
    const p = products.find((x) => x.id === productId);
    if (p) setUnitCost(p.costPrice);
  }, [productId]);

  const submit = () => {
    if (!productId) { setErr("Selecciona un producto."); return; }
    if (Number(qty) <= 0) { setErr("La cantidad debe ser mayor a 0."); return; }
    onSave({ productId, qty: Number(qty), unitCost: Number(unitCost), vendor, date });
  };

  return (
    <Modal title="Registrar compra" onClose={onClose}>
      <FormRow label="Producto">
        <select style={styles.input} value={productId} onChange={(e) => setProductId(e.target.value)}>
          {products.map((p) => (
            <option key={p.id} value={p.id}>{p.name}</option>
          ))}
        </select>
      </FormRow>
      <FormRow label="Proveedor">
        <input style={styles.input} value={vendor} onChange={(e) => setVendor(e.target.value)} placeholder="Ej: Distribuidora Central" />
      </FormRow>
      <div style={styles.formTwoCol}>
        <FormRow label="Cantidad">
          <input style={styles.input} type="number" min="1" value={qty} onChange={(e) => setQty(e.target.value)} />
        </FormRow>
        <FormRow label="Costo unitario">
          <input style={styles.input} type="number" min="0" value={unitCost} onChange={(e) => setUnitCost(e.target.value)} />
        </FormRow>
      </div>
      <FormRow label="Fecha">
        <input style={styles.input} type="date" value={date} onChange={(e) => setDate(e.target.value)} />
      </FormRow>
      <p style={styles.totalPreview}>Total: <strong>{money(Number(qty) * Number(unitCost))}</strong></p>
      {err && <p style={styles.formError}>{err}</p>}
      <div style={styles.modalActions}>
        <button style={styles.secondaryBtn} onClick={onClose}>Cancelar</button>
        <button style={styles.primaryBtn} onClick={submit}>Registrar compra</button>
      </div>
    </Modal>
  );
}

