      authTabBtn: { flex: 1, padding: "8px 0", background: "none", border: "none", color: "#8B93A0", fontSize: 12.5, fontWeight: 600, cursor: "pointer", borderRadius: 6 },
      authTabActive: { background: "#1B232D", color: "#EDEAE1" },
      inputLabel: { display: "block", color: "#8B93A0", fontSize: 11.5, marginBottom: 5 },
      input: { background: "#0E141B", border: "1px solid #2E3844", borderRadius: 6, padding: "9px 12px", color: "#EDEAE1", fontSize: 13, width: "100%" },
      submitBtn: { background: "#E8A63D", color: "#412402", border: "none", borderRadius: 6, padding: "10px", fontWeight: 700, fontSize: 13.5, cursor: "pointer", marginTop: 6 },
      errorMsg: { background: "#3A1F17", color: "#F0987B", padding: "8px 10px", borderRadius: 6, fontSize: 12 },
      demoSection: { marginTop: 18, paddingTop: 14, borderTop: "1px solid #232C37", textAlign: "center" },
      quickDemoBtn: { background: "#1B232D", border: "1px solid #2E3844", color: "#EDEAE1", padding: "4px 10px", borderRadius: 5, fontSize: 11, cursor: "pointer", flex: 1 },

      overlay: { position: "fixed", inset: 0, background: "rgba(10,14,18,0.75)", display: "flex", alignItems: "center", justifyContent: "center", zIndex: 50 },
