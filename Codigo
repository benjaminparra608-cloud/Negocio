        </select>
      </FormRow>
      <div style={styles.formTwoCol}>
        <FormRow label="Cantidad">
          <input style={styles.input} type="number" min="1" value={qty} onChange={(e) => setQty(e.target.value)} />
        </FormRow>
        <FormRow label="Precio unitario">
          <input style={styles.input} type="number" min="0" value={unitPrice} onChange={(e) => setUnitPrice(e.target.value)} />
        </FormRow>
      </div>
      <FormRow label="Fecha">
        <input style={styles.input} type="date" value={date} onChange={(e) => setDate(e.target.value)} />
      </FormRow>
      <p style={styles.totalPreview}>Total: <strong>{money(Number(qty) * Number(unitPrice))}</strong></p>
      {err && <p style={styles.formError}>{err}</p>}
      <div style={styles.modalActions}>
