function ExpenseModal({ onClose, onSave }) {
  const [category, setCategory] = useState(CATEGORY_OPTIONS_EXPENSE[0]);
  const [description, setDescription] = useState("");
  const [amount, setAmount] = useState(0);
  const [date, setDate] = useState(todayStr());
  const [err, setErr] = useState("");

  const submit = () => {
    if (Number(amount) <= 0) { setErr("El monto debe ser mayor a 0."); return; }
    onSave({ category, description, amount: Number(amount), date });
  };

  return (
    <Modal title="Registrar gasto" onClose={onClose}>
      <FormRow label="Categoría">
        <select style={styles.input} value={category} onChange={(e) => setCategory(e.target.value)}>
          {CATEGORY_OPTIONS_EXPENSE.map((c) => <option key={c} value={c}>{c}</option>)}
        </select>
      </FormRow>
      <FormRow label="Descripción">
        <input style={styles.input} value={description} onChange={(e) => setDescription(e.target.value)} placeholder="Ej: Cuenta de luz agosto" />
      </FormRow>
      <div style={styles.formTwoCol}>
        <FormRow label="Monto">
          <input style={styles.input} type="number" min="0" value={amount} onChange={(e) => setAmount(e.target.value)} />
        </FormRow>
