<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Almacen - Control Multi-Bodega & Acceso</title>
  <!-- React & Babel Standalone CDN -->
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #0A0E12; display: flex; justify-content: center; padding: 20px; font-family: 'Inter', system-ui, sans-serif; }
    #root { width: 100%; max-width: 1280px; }
    input, select, button { font-family: inherit; }
    input:focus, select:focus { outline: 2px solid #E8A63D; outline-offset: 1px; }
    button:focus-visible { outline: 2px solid #E8A63D; }
    ::placeholder { color: #6B7280; }
  </style>
</head>
<body>
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo, useRef } = React;

    const Icon = ({ name, size = 16, color = "currentColor", ...props }) => {
      const iconRef = useRef(null);
      useEffect(() => {
        if (window.lucide && iconRef.current) {
          window.lucide.createIcons();
        }
      }, [name]);
      return <i data-lucide={name} style={{ width: size, height: size, color, display: "inline-flex", verticalAlign: "middle" }} ref={iconRef} {...props}></i>;
    };

    const AUTH_KEY = "negocio_active_user_v1";
    const USERS_KEY = "negocio_users_list_v1";
    const SALES_KEY = "negocio_sales_list_v1";
    const PROD_KEY = "negocio_products_v1";

    const initialUsers = [
      { id: "u-admin", name: "Benjamín Parra", email: "admin@negocio.cl", pass: "123", role: "Administrador" },
      { id: "u-bodega", name: "Rodrigo Almacén", email: "bodega@negocio.cl", pass: "123", role: "Bodeguero" },
      { id: "u-ventas", name: "Camila Ventas", email: "ventas@negocio.cl", pass: "123", role: "Vendedor" }
    ];

    const defaultLocations = [
      { id: "loc-central", name: "Bodega Central" },
      { id: "loc-tienda", name: "Tienda Principal" }
    ];

    const initialMockProducts = [
      { id: "p1", name: "Polera Oversize Algodón", category: "Ropa", sku: "ROP-POL-101", barcode: "7801001", costPrice: 6500, salePrice: 14990, minStock: 5, stockByLocation: { "loc-central": 18, "loc-tienda": 4 } },
      { id: "p2", name: "Taza Cerámica Negra", category: "Bazar", sku: "BAZ-TAZ-202", barcode: "7802002", costPrice: 2100, salePrice: 5990, minStock: 6, stockByLocation: { "loc-central": 3, "loc-tienda": 1 } },
      { id: "p3", name: "Gorra Snapback Urbana", category: "Ropa", sku: "ROP-GOR-303", barcode: "7803003", costPrice: 4200, salePrice: 9990, minStock: 2, stockByLocation: { "loc-central": 12, "loc-tienda": 8 } }
    ];

    const initialMockSales = [
      { id: "s1", date: new Date().toISOString().slice(0, 10), customerName: "Carlos Soto", paymentMethod: "Tarjeta Débito", total: 29980, details: "2x Polera Oversize Algodón" },
      { id: "s2", date: new Date().toISOString().slice(0, 10), customerName: "Consumidor Final", paymentMethod: "Efectivo", total: 9990, details: "1x Gorra Snapback" }
    ];

    const money = (n) => new Intl.NumberFormat("es-CL", { style: "currency", currency: "CLP", maximumFractionDigits: 0 }).format(Math.round(Number(n) || 0));
    const getProductTotalStock = (p) => Object.values(p.stockByLocation || {}).reduce((a, b) => a + (Number(b) || 0), 0);

    function App() {
      const [users, setUsers] = useState(() => {
        const local = localStorage.getItem(USERS_KEY);
        return local ? JSON.parse(local) : initialUsers;
      });

      const [currentUser, setCurrentUser] = useState(() => {
        const active = localStorage.getItem(AUTH_KEY);
        return active ? JSON.parse(active) : null;
      });

      const [products, setProducts] = useState(() => {
        const local = localStorage.getItem(PROD_KEY);
        return local ? JSON.parse(local) : initialMockProducts;
      });

      const [sales, setSales] = useState(() => {
        const local = localStorage.getItem(SALES_KEY);
        return local ? JSON.parse(local) : initialMockSales;
      });

      const [tab, setTab] = useState("dashboard");
      const [locations] = useState(defaultLocations);

      // Modal de edición / creación de ventas
      const [saleModalState, setSaleModalState] = useState(null); // null | 'new' | saleObj

      useEffect(() => {
        localStorage.setItem(USERS_KEY, JSON.stringify(users));
      }, [users]);

      useEffect(() => {
        localStorage.setItem(SALES_KEY, JSON.stringify(sales));
      }, [sales]);

      useEffect(() => {
        localStorage.setItem(PROD_KEY, JSON.stringify(products));
      }, [products]);

      useEffect(() => {
        if (currentUser) {
          localStorage.setItem(AUTH_KEY, JSON.stringify(currentUser));
        } else {
          localStorage.removeItem(AUTH_KEY);
        }
        if (window.lucide) window.lucide.createIcons();
      }, [currentUser, tab, sales]);

      const handleLogin = (userObj) => {
        setCurrentUser(userObj);
        setTab("dashboard");
      };

      const handleLogout = () => {
        setCurrentUser(null);
      };

      const handleRegister = (newUser) => {
        setUsers(prev => [...prev, newUser]);
        setCurrentUser(newUser);
      };

      // Operaciones de Ventas (CRUD)
      const handleSaveSale = (saleData) => {
        if (saleModalState === "new") {
          const newEntry = { ...saleData, id: "s-" + Date.now() };
          setSales(prev => [newEntry, ...prev]);
        } else {
          setSales(prev => prev.map(s => s.id === saleModalState.id ? { ...saleData, id: s.id } : s));
        }
        setSaleModalState(null);
      };

      const handleDeleteSale = (saleId) => {
        if (confirm("¿Estás seguro de eliminar esta venta del registro?")) {
          setSales(prev => prev.filter(s => s.id !== saleId));
        }
      };

      if (!currentUser) {
        return <AuthScreen onLogin={handleLogin} onRegister={handleRegister} users={users} />;
      }

      const role = currentUser.role || "Vendedor";
      const canAccessFinances = role === "Administrador";
      const canAccessWarehouses = role === "Administrador" || role === "Bodeguero";
      const canAccessSales = role === "Administrador" || role === "Vendedor";

      const lowStock = products.filter(p => getProductTotalStock(p) <= (p.minStock || 0));
      const totalSales = sales.reduce((a, s) => a + Number(s.total || 0), 0);

      return (
        <div style={styles.app}>
          <aside style={styles.sidebar}>
            <div style={styles.brand}>
              <div style={styles.brandMark}>PRO</div>
              <div>
                <div style={styles.brandTitle}>Almacén PRO</div>
                <div style={styles.brandSub}>Control Multi-Bodega</div>
              </div>
            </div>

            <div style={styles.userCard}>
              <div style={styles.userAvatar}>
                {currentUser.name.slice(0, 2).toUpperCase()}
              </div>
              <div style={{ flex: 1, minWidth: 0 }}>
                <div style={styles.userName}>{currentUser.name}</div>
                <span style={styles.roleBadge}>{currentUser.role}</span>
              </div>
              <button style={styles.logoutBtn} onClick={handleLogout} title="Cerrar sesión">
                <Icon name="log-out" size={14} color="#F0987B" />
              </button>
            </div>

            <nav style={styles.nav}>
              <button onClick={() => setTab("dashboard")} style={{ ...styles.navItem, ...(tab === "dashboard" ? styles.navItemActive : {}) }}>
                <Icon name="layout-dashboard" size={16} />
                <span>Panel</span>
              </button>

              <button onClick={() => setTab("inventario")} style={{ ...styles.navItem, ...(tab === "inventario" ? styles.navItemActive : {}) }}>
                <Icon name="package" size={16} />
                <span>Inventario</span>
                {lowStock.length > 0 && <span style={styles.navBadge}>{lowStock.length}</span>}
              </button>

              {canAccessWarehouses && (
                <button onClick={() => setTab("bodegas")} style={{ ...styles.navItem, ...(tab === "bodegas" ? styles.navItemActive : {}) }}>
                  <Icon name="warehouse" size={16} />
                  <span>Bodegas & Traspaso</span>
                </button>
              )}

              {canAccessSales && (
                <button onClick={() => setTab("ventas")} style={{ ...styles.navItem, ...(tab === "ventas" ? styles.navItemActive : {}) }}>
                  <Icon name="shopping-cart" size={16} />
                  <span>Ventas & Caja</span>
                </button>
              )}

              {canAccessFinances && (
                <button onClick={() => setTab("usuarios")} style={{ ...styles.navItem, ...(tab === "usuarios" ? styles.navItemActive : {}) }}>
                  <Icon name="users" size={16} />
                  <span>Equipo & Accesos</span>
                </button>
              )}
            </nav>

            <div style={styles.footerStatus}>
              <span style={{ width: 7, height: 7, borderRadius: "50%", background: "#4FB3A9" }}></span>
              <span>Conectado: {currentUser.email}</span>
            </div>
          </aside>

          <main style={styles.main}>
            {tab === "dashboard" && (
              <div>
                <div style={styles.pageHeader}>
                  <div>
                    <div style={styles.eyebrow}>RESUMEN GENERAL</div>
                    <h2 style={styles.pageTitle}>Bienvenido, {currentUser.name}</h2>
                  </div>
                  {canAccessSales && (
                    <button style={styles.primaryBtn} onClick={() => setSaleModalState("new")}>
                      <Icon name="plus" size={14} /> Registrar Venta
                    </button>
                  )}
                </div>

                <div style={styles.kpiGrid}>
                  <div style={styles.kpiCard}>
                    <span style={styles.kpiLabel}>Ventas Registradas</span>
                    <div style={{ ...styles.kpiValue, color: "#7FD9C4" }}>{money(totalSales)}</div>
                  </div>
                  <div style={styles.kpiCard}>
                    <span style={styles.kpiLabel}>Productos en Catálogo</span>
                    <div style={{ ...styles.kpiValue, color: "#E8A63D" }}>{products.length} artículos</div>
                  </div>
                  <div style={styles.kpiCard}>
                    <span style={styles.kpiLabel}>Stock Crítico</span>
                    <div style={{ ...styles.kpiValue, color: lowStock.length > 0 ? "#F0987B" : "#7FD9C4" }}>{lowStock.length} items</div>
                  </div>
                </div>

                <div style={styles.dashGrid}>
                  <div style={styles.panel}>
                    <h3 style={styles.panelTitle}>Alertas de Reposición</h3>
                    {lowStock.length === 0 ? (
                      <p style={{ color: "#6B7480", fontSize: 13 }}>Todo el stock se encuentra en niveles óptimos.</p>
                    ) : (
                      lowStock.map(p => (
                        <div key={p.id} style={styles.lowStockRow}>
                          <span>{p.name}</span>
                          <span style={{ color: "#F0987B" }}>{getProductTotalStock(p)} / mín. {p.minStock} un.</span>
                        </div>
                      ))
                    )}
                  </div>
                  <div style={styles.panel}>
                    <h3 style={styles.panelTitle}>Bodegas Operativas</h3>
                    {locations.map(l => (
                      <div key={l.id} style={styles.lowStockRow}>
                        <span>{l.name}</span>
                        <span style={{ color: "#7FD9C4" }}>Activa</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {tab === "inventario" && (
              <div>
                <div style={styles.pageHeader}>
                  <div>
                    <div style={styles.eyebrow}>INVENTARIO GLOBAL</div>
                    <h2 style={styles.pageTitle}>Catálogo y Fichas de Bodega</h2>
                  </div>
                </div>
                <div style={styles.tagGrid}>
                  {products.map(p => (
                    <div key={p.id} style={styles.tag}>
                      <div style={{ display: "flex", justifyContent: "space-between" }}>
                        <span style={{ fontSize: 10, color: "#8A7A4E", fontWeight: 700, textTransform: "uppercase" }}>{p.category}</span>
                        {getProductTotalStock(p) <= p.minStock && <span style={{ background: "#F0997B", color: "#4A1B0C", fontSize: 10, padding: "2px 5px", borderRadius: 4, fontWeight: 700 }}>Stock Bajo</span>}
                      </div>
                      <div style={{ fontSize: 15, fontWeight: 700, margin: "6px 0 2px" }}>{p.name}</div>
                      <div style={{ fontSize: 11, color: "#8A7A4E", fontFamily: "monospace" }}>SKU: {p.sku}</div>
                      <div style={{ borderTop: "1px dashed #C9C2AC", margin: "8px 0" }}></div>
                      <div style={styles.tagRow}><span>Precio Venta:</span><strong>{money(p.salePrice)}</strong></div>
                      <div style={styles.tagRow}><span>Costo Unit.:</span><span>{money(p.costPrice)}</span></div>
                      <div style={styles.tagRow}><span>Stock Total:</span><strong style={{ color: "#1E3A34" }}>{getProductTotalStock(p)} un.</strong></div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {tab === "bodegas" && canAccessWarehouses && (
              <div>
                <div style={styles.pageHeader}>
                  <div>
                    <div style={styles.eyebrow}>LOGÍSTICA</div>
                    <h2 style={styles.pageTitle}>Distribución de Stock por Almacén</h2>
                  </div>
                </div>
                <div style={styles.dashGrid}>
                  {locations.map(loc => (
                    <div key={loc.id} style={styles.panel}>
                      <h3 style={{ color: "#E8A63D", margin: "0 0 12px 0", fontSize: 16 }}>{loc.name}</h3>
                      {products.map(p => (
                        <div key={p.id} style={styles.lowStockRow}>
                          <span>{p.name}</span>
                          <strong style={{ color: "#EDEAE1" }}>{p.stockByLocation?.[loc.id] || 0} un.</strong>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {tab === "ventas" && canAccessSales && (
              <div>
                <div style={styles.pageHeader}>
                  <div>
                    <div style={styles.eyebrow}>PUNTO DE VENTA</div>
                    <h2 style={styles.pageTitle}>Registro y Modificación de Ventas</h2>
                  </div>
                  <button style={styles.primaryBtn} onClick={() => setSaleModalState("new")}>
                    <Icon name="plus" size={14} /> Registrar Venta
                  </button>
                </div>
                <div style={styles.panel}>
                  <table style={{ width: "100%", borderCollapse: "collapse", color: "#EDEAE1", fontSize: 13 }}>
                    <thead>
                      <tr style={{ color: "#8B93A0", textAlign: "left", borderBottom: "1px solid #232C37" }}>
                        <th style={{ padding: 10 }}>Fecha</th>
                        <th>Cliente</th>
                        <th>Detalle / Concepto</th>
                        <th>Medio de Pago</th>
                        <th>Total</th>
                        <th style={{ textAlign: "right", paddingRight: 10 }}>Acciones</th>
                      </tr>
                    </thead>
                    <tbody>
                      {sales.length === 0 ? (
                        <tr>
                          <td colSpan="6" style={{ padding: 16, textAlign: "center", color: "#6B7480" }}>
                            No hay ventas registradas. Haz clic en "Registrar Venta".
                          </td>
                        </tr>
                      ) : (
                        sales.map(s => (
                          <tr key={s.id} style={{ borderBottom: "1px solid #232C37" }}>
                            <td style={{ padding: 10 }}>{s.date}</td>
                            <td style={{ fontWeight: 600 }}>{s.customerName}</td>
                            <td style={{ color: "#8B93A0" }}>{s.details || "Venta general"}</td>
                            <td><span style={styles.badgeGray}>{s.paymentMethod}</span></td>
                            <td style={{ color: "#7FD9C4", fontWeight: 700 }}>{money(s.total)}</td>
                            <td style={{ textAlign: "right", paddingRight: 10 }}>
                              <button
                                style={styles.actionIconBtn}
                                onClick={() => setSaleModalState(s)}
                                title="Modificar venta"
                              >
                                <Icon name="pencil" size={14} color="#E8A63D" />
                              </button>
                              <button
                                style={styles.actionIconBtn}
                                onClick={() => handleDeleteSale(s.id)}
                                title="Eliminar venta"
                              >
                                <Icon name="trash-2" size={14} color="#F0987B" />
                              </button>
                            </td>
                          </tr>
                        ))
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {tab === "usuarios" && canAccessFinances && (
              <UsersManager users={users} onAddUser={(u) => setUsers(prev => [...prev, u])} />
            )}
          </main>

          {/* Modal para Modificar / Crear Venta */}
          {saleModalState && (
            <SaleModal
              sale={saleModalState === "new" ? null : saleModalState}
              onClose={() => setSaleModalState(null)}
              onSave={handleSaveSale}
            />
          )}
        </div>
      );
    }

    // Modal de Modificación / Creación de Ventas
    function SaleModal({ sale, onClose, onSave }) {
      const [customerName, setCustomerName] = useState(sale?.customerName || "");
      const [details, setDetails] = useState(sale?.details || "");
      const [paymentMethod, setPaymentMethod] = useState(sale?.paymentMethod || "Efectivo");
      const [total, setTotal] = useState(sale?.total || 0);
      const [date, setDate] = useState(sale?.date || new Date().toISOString().slice(0, 10));

      const handleSubmit = (e) => {
        e.preventDefault();
        if (!customerName.trim() || Number(total) <= 0) return;
        onSave({
          customerName: customerName.trim(),
          details: details.trim(),
          paymentMethod,
          total: Number(total),
          date
        });
      };

      return (
        <div style={styles.overlay} onClick={onClose}>
          <div style={styles.modal} onClick={e => e.stopPropagation()}>
            <h3 style={{ margin: "0 0 14px", color: "#EDEAE1" }}>
              {sale ? "Modificar Venta" : "Registrar Nueva Venta"}
            </h3>
            <form onSubmit={handleSubmit} style={{ display: "flex", flexDirection: "column", gap: 12 }}>
              <div>
                <label style={styles.inputLabel}>Cliente</label>
                <input
                  style={styles.input}
                  value={customerName}
                  onChange={e => setCustomerName(e.target.value)}
                  placeholder="Ej: Carlos Soto / Consumidor Final"
                  required
                />
              </div>

              <div>
                <label style={styles.inputLabel}>Detalle o Concepto</label>
                <input
                  style={styles.input}
                  value={details}
                  onChange={e => setDetails(e.target.value)}
                  placeholder="Ej: 2x Poleras, 1x Gorra"
                />
              </div>

              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
                <div>
                  <label style={styles.inputLabel}>Medio de Pago</label>
                  <select style={styles.input} value={paymentMethod} onChange={e => setPaymentMethod(e.target.value)}>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Tarjeta Débito">Tarjeta Débito</option>
                    <option value="Tarjeta Crédito">Tarjeta Crédito</option>
                    <option value="Transferencia">Transferencia</option>
                  </select>
                </div>
                <div>
                  <label style={styles.inputLabel}>Total Venta ($)</label>
                  <input
                    style={styles.input}
                    type="number"
                    min="1"
                    value={total}
                    onChange={e => setTotal(e.target.value)}
                    required
                  />
                </div>
              </div>

              <div>
                <label style={styles.inputLabel}>Fecha</label>
                <input
                  style={styles.input}
                  type="date"
                  value={date}
                  onChange={e => setDate(e.target.value)}
                  required
                />
              </div>

              <div style={{ display: "flex", justifyContent: "flex-end", gap: 8, marginTop: 10 }}>
                <button type="button" style={styles.secondaryBtn} onClick={onClose}>Cancelar</button>
                <button type="submit" style={styles.primaryBtn}>
                  {sale ? "Guardar Cambios" : "Guardar Venta"}
                </button>
              </div>
            </form>
          </div>
        </div>
      );
    }

    function AuthScreen({ onLogin, onRegister, users }) {
      const [isRegister, setIsRegister] = useState(false);
      const [email, setEmail] = useState("admin@negocio.cl");
      const [pass, setPass] = useState("123");
      const [name, setName] = useState("");
      const [role, setRole] = useState("Vendedor");
      const [error, setError] = useState("");

      const handleSubmit = (e) => {
        e.preventDefault();
        setError("");

        if (isRegister) {
          if (!name.trim() || !email.trim() || !pass.trim()) {
            setError("Todos los campos son obligatorios.");
            return;
          }
          if (users.some(u => u.email.toLowerCase() === email.trim().toLowerCase())) {
            setError("Ya existe un usuario registrado con este correo.");
            return;
          }
          const newUser = { id: "u-" + Date.now(), name: name.trim(), email: email.trim(), pass, role };
          onRegister(newUser);
        } else {
          const userFound = users.find(u => u.email.toLowerCase() === email.trim().toLowerCase() && u.pass === pass);
          if (userFound) {
            onLogin(userFound);
          } else {
            setError("Credenciales incorrectas. Verifica correo y contraseña.");
          }
        }
      };

      const setDemo = (userEmail) => {
        const u = users.find(x => x.email === userEmail);
        if (u) {
          setEmail(u.email);
          setPass(u.pass);
        }
      };

      return (
        <div style={styles.authContainer}>
          <div style={styles.authCard}>
            <div style={{ textAlign: "center", marginBottom: 22 }}>
              <div style={styles.authLogo}>PRO</div>
              <h2 style={{ color: "#EDEAE1", margin: "10px 0 4px", fontSize: 22 }}>Almacén PRO</h2>
              <p style={{ color: "#8B93A0", fontSize: 13, margin: 0 }}>Control Multi-Bodega & Gestión Comercial</p>
            </div>

            <div style={styles.authTabs}>
              <button
                type="button"
                style={{ ...styles.authTabBtn, ...(isRegister ? {} : styles.authTabActive) }}
                onClick={() => { setIsRegister(false); setError(""); }}
              >
                Iniciar Sesión
              </button>
              <button
                type="button"
                style={{ ...styles.authTabBtn, ...(isRegister ? styles.authTabActive : {}) }}
                onClick={() => { setIsRegister(true); setError(""); }}
              >
                Crear Cuenta
              </button>
            </div>

            <form onSubmit={handleSubmit} style={{ display: "flex", flexDirection: "column", gap: 14 }}>
              {isRegister && (
                <div>
                  <label style={styles.inputLabel}>Nombre completo</label>
                  <input
                    style={styles.input}
                    placeholder="Ej: Juan Pérez"
                    value={name}
                    onChange={(e) => setName(e.target.value)}
                    required
                  />
                </div>
              )}

              <div>
                <label style={styles.inputLabel}>Correo electrónico</label>
                <input
                  style={styles.input}
                  type="email"
                  placeholder="usuario@negocio.cl"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  required
                />
              </div>

              <div>
                <label style={styles.inputLabel}>Contraseña</label>
                <input
                  style={styles.input}
                  type="password"
                  placeholder="••••••••"
                  value={pass}
                  onChange={(e) => setPass(e.target.value)}
                  required
                />
              </div>

              {isRegister && (
                <div>
                  <label style={styles.inputLabel}>Rol en el negocio</label>
                  <select style={styles.input} value={role} onChange={(e) => setRole(e.target.value)}>
                    <option value="Administrador">Administrador (Acceso total)</option>
                    <option value="Bodeguero">Bodeguero (Inventario y transferencias)</option>
                    <option value="Vendedor">Vendedor (Punto de venta y catálogo)</option>
                  </select>
                </div>
              )}

              {error && <div style={styles.errorMsg}>{error}</div>}

              <button type="submit" style={styles.submitBtn}>
                {isRegister ? "Registrar e Ingresar" : "Entrar al Sistema"}
              </button>
            </form>

            {!isRegister && (
              <div style={styles.demoSection}>
                <span style={{ fontSize: 11, color: "#8B93A0" }}>Ingreso rápido de prueba:</span>
                <div style={{ display: "flex", gap: 6, marginTop: 6 }}>
                  <button type="button" style={styles.quickDemoBtn} onClick={() => setDemo("admin@negocio.cl")}>Admin</button>
                  <button type="button" style={styles.quickDemoBtn} onClick={() => setDemo("bodega@negocio.cl")}>Bodega</button>
                  <button type="button" style={styles.quickDemoBtn} onClick={() => setDemo("ventas@negocio.cl")}>Ventas</button>
                </div>
              </div>
            )}
          </div>
        </div>
      );
    }

    function UsersManager({ users, onAddUser }) {
      const [modal, setModal] = useState(false);
      const [name, setName] = useState("");
      const [email, setEmail] = useState("");
      const [pass, setPass] = useState("");
      const [role, setRole] = useState("Vendedor");

      const handleCreate = (e) => {
        e.preventDefault();
        if (!name || !email || !pass) return;
        onAddUser({ id: "u-" + Date.now(), name, email, pass, role });
        setName(""); setEmail(""); setPass(""); setModal(false);
      };

      return (
        <div>
          <div style={styles.pageHeader}>
            <div>
              <div style={styles.eyebrow}>ADMINISTRACIÓN</div>
              <h2 style={styles.pageTitle}>Cuentas y Accesos de Personal</h2>
            </div>
            <button style={styles.primaryBtn} onClick={() => setModal(true)}>+ Agregar Miembro</button>
          </div>

          <div style={styles.panel}>
            <table style={{ width: "100%", borderCollapse: "collapse", color: "#EDEAE1", fontSize: 13 }}>
              <thead>
                <tr style={{ color: "#8B93A0", textAlign: "left", borderBottom: "1px solid #232C37" }}>
                  <th style={{ padding: 10 }}>Nombre</th>
                  <th>Correo</th>
                  <th>Rol asignado</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                {users.map(u => (
                  <tr key={u.id} style={{ borderBottom: "1px solid #232C37" }}>
                    <td style={{ padding: 10, fontWeight: 600 }}>{u.name}</td>
                    <td style={{ color: "#8B93A0" }}>{u.email}</td>
                    <td><span style={styles.badgeOrange}>{u.role}</span></td>
                    <td><span style={{ color: "#7FD9C4", fontSize: 12 }}>● Activo</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {modal && (
            <div style={styles.overlay} onClick={() => setModal(false)}>
              <div style={styles.modal} onClick={e => e.stopPropagation()}>
                <h3 style={{ margin: "0 0 14px", color: "#EDEAE1" }}>Crear Cuenta de Personal</h3>
                <form onSubmit={handleCreate} style={{ display: "flex", flexDirection: "column", gap: 12 }}>
                  <div>
                    <label style={styles.inputLabel}>Nombre</label>
                    <input style={styles.input} value={name} onChange={e => setName(e.target.value)} required />
                  </div>
                  <div>
                    <label style={styles.inputLabel}>Correo</label>
                    <input style={styles.input} type="email" value={email} onChange={e => setEmail(e.target.value)} required />
                  </div>
                  <div>
                    <label style={styles.inputLabel}>Contraseña provisional</label>
                    <input style={styles.input} type="password" value={pass} onChange={e => setPass(e.target.value)} required />
                  </div>
                  <div>
                    <label style={styles.inputLabel}>Rol de acceso</label>
                    <select style={styles.input} value={role} onChange={e => setRole(e.target.value)}>
                      <option value="Administrador">Administrador</option>
                      <option value="Bodeguero">Bodeguero</option>
                      <option value="Vendedor">Vendedor</option>
                    </select>
                  </div>
                  <div style={{ display: "flex", justifyContent: "flex-end", gap: 8, marginTop: 10 }}>
                    <button type="button" style={styles.secondaryBtn} onClick={() => setModal(false)}>Cancelar</button>
                    <button type="submit" style={styles.primaryBtn}>Crear Usuario</button>
                  </div>
                </form>
              </div>
            </div>
          )}
        </div>
      );
    }

